# ── MN Ventures Environment Variables ──────────────────────
# Copy this file to .env and fill in your real values.

# Django
SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# PostgreSQL
DB_NAME=name_bd
DB_USER=sqlite
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Redis + Celery (for background auction closing)
REDIS_URL=redis://localhost:6379/0

# M-Pesa / Daraja API — get credentials from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_SHORTCODE=
MPESA_ACCOUNT_NUMBER=
MPESA_CALLBACK_URL=https://yourdomain.com/payments/mpesa/callback/
MPESA_SANDBOX=True   # set to False in production

# Email (for optional notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=MN Ventures <noreply@example.co.ke>

# Rate limits
RATE_LIMIT_BID_MAX=10
RATE_LIMIT_BID_WINDOW=60
RATE_LIMIT_ENQUIRY_MAX=5
RATE_LIMIT_ENQUIRY_WINDOW=300

# Auction integrity
AUCTION_SNIPE_WINDOW=120
AUCTION_SNIPE_EXTENSION=120
AUCTION_MAX_EXTENSIONS=5
AUCTION_MAX_BIDS_PER_BIDDER=20

# Business
VAT_REGISTRATION=   # Add your KRA PIN when VAT-registered

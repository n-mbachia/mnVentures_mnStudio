{% load store_tags %}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>{{ site_url }}/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>{{ site_url }}/about/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>

  <url>
    <loc>{{ site_url }}/auctions/</loc>
    <changefreq>hourly</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>{{ site_url }}/terms/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>

  {% for product in products %}
  <url>
    <loc>{{ site_url }}/products/{{ product.slug }}/</loc>
    <lastmod>{{ product.updated_at|date:"Y-m-d" }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}

  {% for auction in auctions %}
  <url>
    <loc>{{ site_url }}/auctions/{{ auction.slug }}/</loc>
    <lastmod>{{ auction.created_at|date:"Y-m-d" }}</lastmod>
    <changefreq>hourly</changefreq>
    <priority>0.9</priority>
  </url>
  {% endfor %}

</urlset>
